<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.myapplication">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShiftTracker">
        <activity
            android:name=".controller.Traveling"
            android:exported="false" />
        <activity
            android:name=".controller.Entertainment"
            android:exported="false" />
        <activity
            android:name=".controller.SetBudget"
            android:exported="false" />
        <activity
            android:name=".model.Shopping"
            android:exported="false" />
        <activity
            android:name=".model.Food"
            android:exported="false" /> <!-- CalendarActivity declaration -->
        <activity
            android:name=".controller.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- BudgetMainActivity declaration -->
        <activity
            android:name=".controller.BudgetMainActivity"
            android:exported="true" />
        <activity
            android:name=".controller.JobDetailActivity"
            android:exported="true" />
    </application>

</manifest>