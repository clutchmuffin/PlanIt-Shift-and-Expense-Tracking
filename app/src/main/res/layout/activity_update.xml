<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AddActivity">


    <androidx.cardview.widget.CardView
        app:cardBackgroundColor="@color/black"
        android:layout_width="match_parent"
        android:layout_height="70dp">

        <TextView
            android:id="@+id/addTv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="UPDATE EXPENSE"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>







    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="16dp">

        <TextView
            android:id="@+id/buyDisplay2"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity=""
            android:text="How much money do you want to spend: "
            android:textSize="18sp"
            />

        <EditText
            android:clickable="true"
            android:elevation="2dp"
            android:id="@+id/updateBuy"
            android:layout_width="match_parent"
            android:hint="5000"
            android:textColorHint="@color/black"
            android:padding="10dp"
            android:textColor="@color/black"
            android:inputType="numberDecimal"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ed_shape"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="16dp">

        <TextView
            android:id="@+id/reasonDisplay2"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity=""
            android:text="What is the reason behind spending?: "
            android:textSize="18sp"
            />

        <EditText
            android:id="@+id/updateReason"
            android:layout_width="match_parent"
            android:hint="Reason"
            android:textColorHint="@color/black"
            android:padding="10dp"
            android:textColor="@color/black"
            android:inputType="textPersonName"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ed_shape"/>

    </LinearLayout>

    <Button
        android:id="@+id/updateButton"
        android:layout_width="232dp"
        android:layout_height="69dp"
        android:layout_gravity="center"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/round"
        android:gravity="center"
        android:text="Update"
        android:textColor="@color/white"/>

</LinearLayout>
